# admin.nullroute.diy settings, for local development.
#
# Copy to apps/admin/.env, which is never committed. Production values live in
# the Vercel project nullroute-admin, never in a file. src/server/env.ts parses
# these and refuses to start with any missing, naming which.

# This console's own address. Sign-in emails link here.
PUBLIC_ORIGIN=http://localhost:3471

# Who may sign in, comma separated. Anyone else gets the same answer and no email.
OWNER_EMAILS=

# HMAC key for sign-in codes and the known-browser cookie. At least 32 characters:
#   node -e "console.log(require('node:crypto').randomBytes(36).toString('base64url'))"
CODE_SECRET=

# Vercel's daily cron sends this as a bearer token. At least 16 characters.
CRON_SECRET=

# Supabase's transaction pooler (port 6543). The connection checks the server's
# certificate against the root pinned in src/server/supabase-ca.ts.
DATABASE_URL=

# A Resend key that can only send, and only from nullroute.diy.
RESEND_API_KEY=
MAIL_FROM=nullroute <signin@nullroute.diy>
CONTACT_FROM=nullroute.diy <contact@nullroute.diy>
CONTACT_TO=

# Pages allowed to post the contact form, comma separated.
SITE_ORIGINS=http://localhost:3000

# Optional. Without it the overview reads GitHub anonymously, which Vercel's
# shared addresses can exhaust; a fine-grained, read-only token for public
# repositories is enough.
GITHUB_TOKEN=

# Local only: write mail to files in this directory instead of sending it.
# Ignored in production.
MAIL_DIR=
