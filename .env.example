# nullroute environment.
#
# This file documents what .env may contain. Never commit .env itself.
#
# Nothing in packages/ reads environment variables for anything security
# relevant. The device has no configuration that arrives this way, on purpose:
# an air-gapped signer whose behaviour depends on ambient environment is a
# signer whose behaviour you cannot reproduce. Everything below is for the
# website and for deploys.

# --- Website ---
# Canonical URLs and Open Graph metadata. Vercel sets this per environment;
# locally it is the dev server.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Provisioning ---
# Account-level Vercel token, used by the CLI for deploys. Not read at runtime
# and not set as a project environment variable in Vercel.
VERCEL_TOKEN=
