{
  "//": "Emitting build project: composite, declarations, src only.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/main.tsx", "src/App.tsx", "src/lib/transport.ts"],
  "references": [{ "path": "../core/tsconfig.build.json" }]
}
