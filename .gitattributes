* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.img binary
*.psbt binary
*.txn binary

# Generated. Collapsed in diffs so lockfile churn does not bury a real change.
package-lock.json linguist-generated=true -diff

# MANIFEST.lock is generated by `make manifest` and is one line per source file.
# Not collapsed: a change here is exactly what a reviewer must look at.
MANIFEST.lock -diff
