# Every package is attack surface and every package goes into the reproducible
# build manifest. These settings are load-bearing, not preferences.

# No package runs arbitrary code at install time. This has already cost us
# convenient options (anything needing a native or WASM build step) and it will
# cost us more. A device that holds keys does not execute vendor scripts.
ignore-scripts=true

# Exact versions only. A caret range means two `npm install` runs a week apart
# can produce different code with the same lockfile intent, which breaks the
# reproducibility claim the manifest root hash rests on.
save-exact=true

# Surface advisories at install time rather than at release time.
audit=true

fund=false

# `npm ci` is the only supported install path. See the Makefile.
engine-strict=true
