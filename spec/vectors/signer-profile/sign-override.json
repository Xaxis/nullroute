  "file": "sign-override.json",
  "requirements": [
    "SP-REV-22"
  ],
  "operations": "signOverride",
  "description": "A blocking condition disables signing. It may be lifted only by an explicit override that applies to one signature and is never stored: each case asks to sign without an override, with one, and without one again. A transaction the signer owns no input of is refused, and no override lifts that.",
  "cases": [
    {
      "id": "sighash-none-lifted-for-one-signature",
      "operation": "signOverride",
      "requirements": [
        "SP-REV-22",
        "SP-REV-23"
      ],
      "level": "MUST",
      "description": "One owned input requesting SIGHASH_NONE, which blocks signing. Signed without an override, with one, and without one again.",
      "input": {
        "psbt": "",
        "context": "abandon-mainnet"
      },
      "expected": {
        "withoutOverride": "not-signed",
        "withOverride": "may-sign",
        "signatures": {
          "0": true
        }
      },
      "sources": [
        "blocking: SP-REV-23 text",
        "override: SP-REV-22 text, \"It MAY be lifted only by an explicit override that applies to one signature and is never stored\""
      ],
      "bitcoinCore": {
        "fee": "0.00010000",
        "sighash": [
          "NONE"
        ]
      }
    },
    {
      "id": "unconfirmed-amount-lifted-for-one-signature",
      "operation": "signOverride",
      "requirements": [
        "SP-REV-22",
        "SP-REV-3"
      ],
      "level": "MUST",
      "description": "One owned segwit v0 input with only PSBT_IN_WITNESS_UTXO, so its amount is the coordinator's word and signing is blocked. Signed without an override, with one, and without one again.",
      "input": {
        "psbt": "cHNidP8BAFICAAAAAYtlAugk9Uepb7GV6/LkTMKFPWHrI2Z1IN+JnbGfE0muAAAAAAD9////AfDKBSoBAAAAFgAU+Zf9NLw1tuyNi/jxn+NtAHsWczkAAAAAAAEBHwDyBSoBAAAAFgAUwM681sPTyox13F7GLr5VMw75EOIiBgMw1U/Q3UIKbl+NNiT180gsrjUPedXwdTv1vu+cLZGvPBhzxdoKVAAAgAAAAIAAAACAAAAAAAAAAAAAAA==",
        "context": "abandon-mainnet"
      },
      "expected": {
        "withoutOverride": "not-signed",
        "withOverride": "may-sign",
        "signatures": {
          "0": true
        }
      },
      "sources": [
        "blocking: SP-REV-3 text, BIP-174 line 415",
        "override: SP-REV-22 text, \"It MAY be lifted only by an explicit override that applies to one signature and is never stored\""
      ],
      "bitcoinCore": {
        "fee": "0.00010000"
      }
    },
    {
      "id": "no-owned-input-not-lifted",
      "operation": "signOverride",
      "requirements": [
        "SP-REV-22",
        "SP-REV-25"
      ],
      "level": "MUST",
      "description": "One input, owned by another wallet. There is nothing this signer can sign, and an override does not change that.",
      "input": {
        "psbt": "",
        "context": "abandon-mainnet"
      },
      "expected": {
        "withoutOverride": "not-signed",
        "withOverride": "refuse"
      },
      "sources": [
        "verdict: SP-REV-25 text",
        "override: SP-REV-22 text, \"It MAY be lifted only by an explicit override that applies to one signature and is never stored\""
      ],
      "bitcoinCore": {
