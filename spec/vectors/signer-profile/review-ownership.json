{
  "format": "signer-profile-vectors",
  "version": 1,
  "profile": "spec/signer-profile.md, draft specification version 0.1",
  "file": "review-ownership.json",
  "requirements": [
    "SP-REV-24",
    "SP-REV-25"
  ],
  "operations": "review, sign",
  "description": "A transaction with no input the signer owns is not signable, and signing keys are found from each input's own script, never from a derivation path the PSBT supplies.",
  "cases": [
    {
      "id": "no-owned-input-review",
      "operation": "review",
      "requirements": [
        "SP-REV-24"
      ],
      "level": "MUST",
      "description": "Every input belongs to another wallet (BIP-32 test vector 1). The transaction MUST NOT be signable.",
      "input": {
        "psbt": "",
        "context": "abandon-mainnet"
      },
      "expected": {
        "verdict": "refuse"
      },
      "sources": [
        "verdict: SP-REV-24 text; Core getaddressinfo ismine=false for the input address"
      ],
      "bitcoinCore": {
        "fee": "0.00010000"
      }
    },
    {
      "id": "no-owned-input-sign",
      "operation": "sign",
      "requirements": [
        "SP-REV-24"
      ],
      "level": "MUST",
      "description": "Asking to sign it anyway MUST fail visibly, not return an unsigned PSBT.",
      "input": {
        "psbt": "",
        "context": "abandon-mainnet"
      },
      "expected": {
        "verdict": "refuse"
      },
      "sources": [
        "verdict: SP-REV-24 text"
      ],
      "bitcoinCore": {
        "fee": "0.00010000"
      }
    },
    {
      "id": "foreign-input-with-our-derivation-claim",
      "operation": "sign",
      "requirements": [
        "SP-REV-24",
        "SP-REV-25"
      ],
      "level": "MUST",
      "description": "A foreign segwit v0 input whose PSBT_IN_BIP32_DERIVATION names the signer's fingerprint, the path m/84'/0'/0'/0/0 and its public key (BIP-84 line 79). The script is not the signer's, so it MUST NOT sign.",
      "input": {
        "psbt": "",
        "context": "abandon-mainnet"
      },
      "expected": {
        "verdict": "refuse"
      },
      "sources": [
        "verdict: SP-REV-25 text"
      ],
      "bitcoinCore": {
        "fee": "0.00010000"
      }
    },
    {
      "id": "foreign-taproot-input-with-our-derivation-claim",
      "operation": "sign",
      "requirements": [
        "SP-REV-24",
        "SP-REV-25"
      ],
      "level": "MUST",
      "description": "As above for a foreign taproot input carrying PSBT_IN_TAP_BIP32_DERIVATION for the BIP-86 key at m/86'/0'/0'/0/0.",
      "input": {
        "psbt": "",
        "context": "abandon-mainnet"
      },
      "expected": {
        "verdict": "refuse"
      },
      "sources": [
        "verdict: SP-REV-25 text; key from BIP-86 line 97"
      ],
      "bitcoinCore": {
        "fee": "0.00010000"
      }
    },
    {
      "id": "sign-only-the-owned-input",
      "operation": "sign",
      "requirements": [
        "SP-REV-25"
      ],
      "level": "MUST",
      "description": "Input 0 is the signer's taproot input. Input 1 is foreign and carries a derivation record naming the signer. Only input 0 may receive a signature.",
      "input": {
        "psbt": "",
        "context": "abandon-mainnet"
      },
      "expected": {
        "verdict": "signed",
        "signatures": {
          "0": true,
          "1": false
        }
      },
      "sources": [
        "verdict: SP-REV-25 text"
      ],
      "bitcoinCore": {
        "fee": "0.00010000"
      }
    }
  ],
  "bitcoinCore": "/Satoshi:31.1.0/",
