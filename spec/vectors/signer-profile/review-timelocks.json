      "input": {
        "psbt": "",
        "context": "abandon-mainnet"
      },
      "expected": {
        "verdict": "allow",
        "locktime": {
          "kind": "none",
          "value": 0
        },
        "replaceable": true
      },
      "sources": [
        "locktime kind: values below 500000000 are block heights, others are UNIX times (Bitcoin Core v31.1 src/script/script.h line 47, LOCKTIME_THRESHOLD)",
        "replaceable: BIP-125 line 40, explicit signalling if any input has nSequence below 0xfffffffe; Core getmempoolentry bip125-replaceable agrees, recorded below"
