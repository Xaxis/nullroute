    { "case": "raw(deadbeef)#", "why": "missing checksum" },
    { "case": "raw(deadbeef)#89f8spxmx", "why": "checksum too long, 9 characters" },
    { "case": "raw(deadbeef)#89f8spx", "why": "checksum too short, 7 characters" },
    { "case": "raw(deedbeef)#89f8spxm", "why": "error in payload" },
    { "case": "raw(deedbeef)##9f8spxm", "why": "error in checksum" }
