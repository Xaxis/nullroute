# The signing daemon.
#
# WHY THIS FILE EXISTS AT ALL. provisioning/profiles/os-signer.yaml has asserted
# things about `nullrouted.service` since the profile system was written, and
# the unit did not exist. An assertion about a file nobody has written is a
# claim, not a check, which is the exact species of thing that whole directory
# was built to stop.
#
# WHAT THE DIRECTIVES ARE FOR. This process holds key material and talks to
# exactly two things: one Unix socket and one device node. It has no reason to
# retain a capability, an address family beyond AF_UNIX, or any view of the rest
# of the filesystem. INV-PROV-18 puts a number on that with `systemd-analyze
# security`, and the number is a configuration lint rather than a measurement of
# behaviour: see the limits that verifier prints.
#
# MemoryDenyWriteExecute IS DELIBERATELY ABSENT. It is the single most effective
# directive available here and it crashes Node outright, because V8's baseline
# compiler needs writable-then-executable pages. It works under `node --jitless`,
# and that is no longer an acceptable trade: the wallet store stretches its
# passphrase with Argon2id from @noble/hashes, which is pure JavaScript, and an
# interpreter with no JIT runs it about fifty times slower. Measured at the
# shipped parameters of 64 MiB and three passes, 643ms with the JIT and 34.4
# seconds without, on a machine considerably faster than a Pi. Adopting it costs
# minutes per unlock attempt, a much weaker key derivation, or a native Argon2
# and the supply chain review that comes with it. See docs/VERIFICATION.md.

[Unit]
Description=nullroute signing daemon
Documentation=https://nullroute.diy/docs/verification
# Nothing else may order itself in front of this. INV-PROV-17 reads every unit
# in the image and fails if one does, because a unit that runs first on a device
# whose whole claim is verified boot is a unit nobody verified.
DefaultDependencies=no
After=local-fs.target
Requires=local-fs.target

[Service]
# TYPE=exec, NOT notify, AND THIS IS A CORRECTION RATHER THAN A PREFERENCE.
#
# It was Type=notify with NotifyAccess=main, and the daemon never sends
# READY=1, because it cannot: systemd's notification socket is a Unix DATAGRAM
# socket and Node has no way to write to one without native code. So systemd
# waited for a readiness message that was never coming, held the job open for
# its full start timeout, and would then have killed a daemon that was up and
# listening and restarted it, forever. Under QEMU: "Job nullrouted.service/start
# running (31s / 1min 47s)" with the socket already created.
#
# Type=exec means ready once the process has successfully exec'd, which is
# honest about what systemd can observe here. What it loses is the guarantee
# that the socket exists before the kiosk starts, and nullroute-kiosk.service
# gets that back with an explicit wait rather than by claiming a protocol the
# daemon does not speak.
Type=exec
# --jitless is NOT passed. See the note above.
# WHERE THE DAEMON LOOKS FOR ITS OWN EVIDENCE. main.js falls back to three
# directories above itself, which is the repository layout and is not the image
# layout, so on a device it resolved to /usr and found nothing. The daemon then
# did exactly what it is supposed to do and refused to start: "No verification
# report was found." That refusal is the first rule in this project, so the fix
# is to put the evidence where it looks rather than to loosen the check.
Environment=NULLROUTE_ROOT=/usr/lib/nullroute
# The store on the writable partition, not on the read-only root. Without this
# it would be /usr/lib/nullroute/.nullroute-store, which is inside the erofs
# image and inside the dm-verity tree, and therefore unwritable by design.
Environment=NULLROUTE_STORE=/var/lib/nullroute
ExecStart=/usr/lib/nullroute/bin/node /usr/lib/nullroute/daemon/main.js
Restart=on-failure
RestartSec=2

User=nullroute
Group=nullroute
RuntimeDirectory=nullroute
RuntimeDirectoryMode=0710
StateDirectory=nullroute
StateDirectoryMode=0700

# --- The filesystem ---------------------------------------------------------
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/nullroute
InaccessiblePaths=/boot

# --- Privileges -------------------------------------------------------------
NoNewPrivileges=true
PrivateUsers=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
UMask=0077

# --- The network that is not there ------------------------------------------
# The application has no code that can open a socket and a lint rule fails the
# build if anyone adds one (INV-NET-2). These two are the kernel saying no as
# well, so a defeat of every application-level defence still cannot reach a
# network. A loopback IPC socket is a Unix socket and is unaffected.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

# --- Devices ----------------------------------------------------------------
# One node, read only: the hardware random number generator. Nothing else, which
# includes the SD card reader and the camera.
DevicePolicy=closed
DeviceAllow=/dev/hwrng r

# --- Syscalls ---------------------------------------------------------------
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @swap @reboot
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
