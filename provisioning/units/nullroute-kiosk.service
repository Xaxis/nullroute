# The frontend, in a kiosk browser.
#
# THE WEAKEST COMPONENT ON THE DEVICE, and the profile says so in a threshold
# rather than in a paragraph: INV-PROV-19 allows this unit an exposure of 3.0
# where the daemon is held to 0.5. Averaging the two would hide the difference,
# which is why they are separate assertions.
#
# WHY IT CANNOT BE HARDENED LIKE THE DAEMON. Chromium's own sandbox needs
# unprivileged user namespaces. The directives that make nullrouted safe,
# PrivateUsers=true and RestrictNamespaces, force --no-sandbox, and a browser
# with no sandbox is strictly worse than a slightly higher exposure score. So
# this unit keeps the namespace directives off and keeps Chromium's sandbox on.
#
# The design response to that is not a better unit file. It is keeping trust out
# of the browser: the daemon holds the keys, and this process receives xpubs,
# addresses, descriptors and PSBTs and nothing else (INV-KEY-1).

[Unit]
Description=nullroute kiosk frontend
Documentation=https://nullroute.diy/docs/verification
# After the daemon, never before it. INV-PROV-17 fails any unit that orders
# itself in front of nullrouted.service.
After=nullrouted.service
Requires=nullrouted.service
# THE CAMERA'S DEVICE CLASS HAS TO EXIST WHEN THIS UNIT STARTS.
# systemd.resource-control(5): a device group not listed in /proc/devices at
# start is silently left out of the allow list. "video4linux" is registered
# there by the videodev module, and with no camera plugged at boot nothing
# loads it, so without these two lines DeviceAllow=char-video4linux below would
# be dropped and the camera refused by the cgroup for the life of the session.
# The man page's own answer is this pair. INV-PROV-27 checks both.
Wants=modprobe@videodev.service
After=modprobe@videodev.service

[Service]
Type=simple
# Waits for the daemon's socket rather than trusting the ordering. After= and
# Requires= only guarantee that nullrouted.service was STARTED first, and with
# Type=exec that means "the process exec'd", not "the socket exists". A browser
# launched into that gap shows connection refused on the first screen the device
# ever displays.
# `+` runs it with full privileges, unlike the browser it gates.
# RuntimeDirectoryMode=0710 on the daemon's /run/nullroute means nullroute-ui
# cannot so much as stat the socket, which is deliberate: the frontend talks
# over the loopback bridge, never to the socket directly.
ExecStartPre=+/usr/lib/nullroute/bin/wait-for-daemon
# CAGE, AND THAT IS A CORRECTION. This unit first tried --ozone-platform=drm on
# the reasoning that a device showing one full screen page has no use for a
# display server, and the argument was good and the fact was wrong: Debian's
# Chromium is not built with the DRM ozone backend, and says so at the only
# moment anybody would find out. "FATAL: Invalid ozone platform: drm".
#
# So there is a compositor, and it is the smallest one that exists for this job.
# cage runs exactly one application, full screen, with no decorations, no
# launcher, no second window and no way to reach one. What it costs is wlroots;
# what X would have cost is a display server, a window manager and a session
# manager. Chromium talks Wayland to it.
#
# PAMName=login is what makes this work as a service rather than a login. It
# opens a logind session on the VT below, and a session is what grants a seat:
# without one the compositor cannot become DRM master and cannot read the
# touchscreen, whatever the file permissions say.
#
# A WRITABLE PROFILE DIRECTORY, WHICH IS WHAT CRASHPAD WAS ACTUALLY ASKING FOR.
# The browser died on every boot with "chrome_crashpad_handler: --database is
# required" and status 5/TRAP, and the obvious reading was that crash reporting
# needed switching off. It was not: --disable-crash-reporter is a Firefox flag
# and does nothing here, and the message is crashpad saying it has nowhere to
# put a database. This user has no home (/nonexistent), the root filesystem is
# read-only erofs, and Chromium had no writable directory of any kind, so it
# could not derive one. # THREE DIRECTORIES, NOT ONE. RuntimeDirectory creates exactly what it is
# named and nothing below it, and Chromium does not create its own crash
# database directory: pointed at one that does not exist it spawns the crashpad
# handler with no --database at all, the handler exits, and the browser dies on
# the broken socket with SIGTRAP. The verbose log says it plainly, once you ask
# for it: "is_official_chrome_build is false so returning false", and then a
# handler with no arguments.
RuntimeDirectory=nullroute-ui nullroute-ui/profile nullroute-ui/crash nullroute-ui/config nullroute-ui/cache

# HOME, WHICH IS THE ONE THAT ACTUALLY MATTERS. This account's home in
# /etc/passwd is /nonexistent, deliberately, because nothing should log in as
# it. Chromium derives chrome::DIR_CRASH_DUMPS from the DEFAULT user data
# directory, $XDG_CONFIG_HOME or $HOME/.config/chromium, and NOT from
# --user-data-dir. With no usable home it computes an empty path, spawns
# chrome_crashpad_handler with no --database at all, the handler exits on its
# own argument check, and the browser dies on the closed socket with SIGTRAP.
#
# Four rebuilds went into finding that, each one fixing something plausible and
# adjacent: the crash reporter flags, a writable profile directory, the missing
# chromium-sandbox package, Debian's launcher script. All four were real
# problems. None of them was this one.
Environment=HOME=/run/nullroute-ui
Environment=XDG_CONFIG_HOME=/run/nullroute-ui/config
Environment=XDG_CACHE_HOME=/run/nullroute-ui/cache

#
# --disable-breakpad, which IS a Chromium flag, stays: a crash reporter on a
# device with no network has nowhere to send anything and is one more parser
# next to the keys.
# THE BINARY, NOT DEBIAN'S LAUNCHER SCRIPT. /usr/bin/chromium is a shell
# wrapper that sources /etc/chromium.d/*, and what it adds is desktop defaults
# nobody on this device chose: --enable-remote-extensions, a --load-extension
# glob over /usr/share/chromium/extensions, and three exported Google API keys.
# Remote extensions on the machine that reviews transactions is the opposite of
# what this unit is for, and the keys are meaningless without a network and
# still baked into every process. Calling the binary directly means the flag
# list below is the whole flag list.
ExecStart=/usr/bin/cage -- /usr/lib/chromium/chromium \
  --kiosk \
  --incognito \
  --noerrdialogs \
  --disable-infobars \
  --disable-features=TranslateUI,AutofillServerCommunication \
  --check-for-update-interval=31536000 \
  --disable-background-networking \
  --ozone-platform=wayland \
  --user-data-dir=/run/nullroute-ui/profile \
  --crash-dumps-dir=/run/nullroute-ui/crash \
  --disable-breakpad \
  --disable-sync \
  --disable-component-update \
  --window-size=800,480 \
  http://127.0.0.1:5180/
Restart=on-failure
RestartSec=2

User=nullroute-ui
Group=nullroute-ui
# `video` for /dev/dri and for the camera's /dev/video* node. DeviceAllow is the cgroup half of that permission and
# the file mode is the other half: without the group the browser is refused by
# the filesystem after systemd has already allowed it, which reads as a DRM bug
# rather than a permissions one.
SupplementaryGroups=video input render
# A seat, not just permissions. DeviceAllow and the groups are the cgroup and
# filesystem halves; logind is the half that hands out DRM master.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# `tty`, not `tty-fail`. A board with a panel has /dev/tty1; the QEMU harness
# has a serial console and no virtual terminal, and tty-fail turns that into
# 208/STDIN before cage runs at all, which hides whatever the compositor would
# have said. Failing here should be the compositor's job, with its reason.
StandardInput=tty
RuntimeDirectory=nullroute-ui
StateDirectory=nullroute-ui
StateDirectoryMode=0700

# --- What can still be applied ----------------------------------------------
# Everything that does not break Chromium's own sandbox. PrivateUsers and
# RestrictNamespaces are the two that would, and they are absent on purpose.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectProc=invisible
ReadWritePaths=/var/lib/nullroute-ui
InaccessiblePaths=/boot /var/lib/nullroute

NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
UMask=0077

# Loopback only. The frontend talks to the daemon and to nothing else, and there
# is no network on this device for it to reach anyway.
IPAddressDeny=any
IPAddressAllow=localhost

# The panel, the input devices and the camera, and nothing else. No hardware
# random number generator here: entropy is the daemon's business.
DevicePolicy=closed
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=char-input r
# THE CAMERA, WHICH IS A USB (UVC) WEBCAM. The browser reads QR codes through
# getUserMedia, so it needs /dev/video*, and under DevicePolicy=closed the
# cgroup refuses every node not listed here whatever the file mode says. A
# class rather than a path, because the node a webcam gets depends on what
# else is plugged in. INV-PROV-27 pins this list: this line and nothing else
# was added for the camera.
#
# It only takes effect if videodev is loaded before this unit starts, which is
# what the modprobe@videodev.service pair in [Unit] is for. See there.
DeviceAllow=char-video4linux rw

# --- What Chromium's sandbox does not need ----------------------------------
# Its sandbox works by entering a user namespace and dropping into it. It does
# not need capabilities on the host, it does not need the syscalls below, and it
# does not need an address family beyond the loopback it reaches the daemon on.
# These are the directives that close most of the exposure gap without touching
# the namespaces the sandbox is built out of.
#
# NOT VALIDATED BY RUNNING CHROMIUM. There is no browser on this image yet and
# no server behind the URL above, so what follows is reasoned from how the
# sandbox works rather than from watching it start. The first boot is what
# settles it, and if one of these has to come off, the exposure number in
# provisioning/profiles/os-signer.yaml moves with it rather than the other way
# around.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete @debug @mount @swap @reboot @raw-io @resources @cpu-emulation @module @clock
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=graphical.target
